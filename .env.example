# Template. Copy to .env.local and fill in.
#   cp .env.example .env.local

# REQUIRED. Neon Postgres pooled connection string (free tier, no card).
# https://neon.tech — use the string whose host contains "-pooler".
DATABASE_URL=""

# OPTIONAL. Pre-fills the /setup screen. Public, not a secret.
SLEEPER_USERNAME=""

# OPTIONAL. SportsGameOdds free tier, for projection layer 3 (player props).
# https://sportsgameodds.com — app works without it; layers 1 and 2 need no key.
SPORTSGAMEODDS_API_KEY=""

# REQUIRED for deploy. Guards /api/cron/*. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# OPTIONAL. Turns on "Ask Claude" and "Draft a pitch" in the trade builder.
# https://console.anthropic.com — set a monthly spend limit there too.
ANTHROPIC_API_KEY=""

# OPTIONAL. Max Claude calls per UTC day across the whole site (default 100).
# The site has no login, so this caps what anyone who finds it can spend.
AI_DAILY_CALL_LIMIT=""
